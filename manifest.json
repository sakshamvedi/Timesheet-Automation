{
  "manifest_version": 3,
  "name": "Smart Timesheet Tracker",
  "version": "1.0",
  "description": "Automatically tracks activities and fills timesheet using Gemini AI",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html"

  }
}